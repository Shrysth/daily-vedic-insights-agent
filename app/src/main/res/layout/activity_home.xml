<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cosmic_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <TextView
            android:id="@+id/textDate"
            style="@style/VedicTextAppearanceBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TODAY · PANCHANG"
            android:textColor="@color/celestial_gold_light"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Jyotish Darpana"
            android:textAppearance="@style/VedicTextAppearanceDisplay" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/cosmic_surface"
            app:cardCornerRadius="24dp"
            app:strokeColor="@color/cosmic_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <com.vedicinsights.agent.ui.home.view.MoonSphereView
                    android:id="@+id/heroMoonCanvas"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:contentDescription="Current lunar phase" />

                <TextView
                    android:id="@+id/textTithiBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:text="Panchang loading"
                    android:textColor="@color/celestial_gold_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textPanchangSummary"
                    style="@style/VedicTextAppearanceBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Local astronomical details will appear here."
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/textSunriseSunset"
                    style="@style/VedicTextAppearanceMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Sunrise -- · Sunset --" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TODAY'S CALENDAR &amp; OBSERVANCES"
            android:textColor="@color/celestial_gold_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/cosmic_surface"
            app:cardCornerRadius="18dp">

            <TextView
                android:id="@+id/textFestivalBanner"
                style="@style/VedicTextAppearanceBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Local calendar observances will appear here."
                android:textColor="@color/text_secondary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ANCHOR CONDITIONS"
            android:textColor="@color/celestial_gold_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/cosmic_surface"
            app:cardCornerRadius="18dp">

            <TextView
                android:id="@+id/textAnchorCards"
                style="@style/VedicTextAppearanceBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="7dp"
                android:padding="18dp"
                android:text="Tithi  ·  Nakshatra  ·  Lunar month"
                android:textColor="@color/text_secondary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="24-HOUR MUHURTA MATRIX"
            android:textColor="@color/celestial_gold_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:scrollbars="horizontal">

            <LinearLayout
                android:id="@+id/timelineContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/textTimelineLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Green: favorable overlap · Coral: caution"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="NEXT 3 OCCURRENCES"
            android:textColor="@color/celestial_gold_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/cosmic_surface"
            app:cardCornerRadius="18dp">

            <TextView
                android:id="@+id/textNextOccurrences"
                style="@style/VedicTextAppearanceBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="7dp"
                android:padding="18dp"
                android:text="Add a recurring event to simulate upcoming matches."
                android:textColor="@color/text_secondary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenEvents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Create event" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Settings" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cosmic_surface"
        app:itemIconTint="@color/celestial_gold_light"
        app:itemTextColor="@color/text_primary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation" />
</LinearLayout>
