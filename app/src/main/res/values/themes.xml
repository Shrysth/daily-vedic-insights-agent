<resources>
    <style name="Theme.VedicInsights" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/celestial_gold</item>
        <item name="colorOnPrimary">@color/cosmic_background</item>
        <item name="colorSecondary">@color/celestial_gold_light</item>
        <item name="colorSurface">@color/cosmic_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/cosmic_surface_variant</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:colorBackground">@color/cosmic_background</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/cosmic_background</item>
        <item name="android:navigationBarColor">@color/cosmic_background</item>
    </style>

    <style name="VedicTextAppearanceDisplay">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="VedicTextAppearanceBody">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="VedicTextAppearanceMono">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/celestial_gold_light</item>
    </style>
</resources>
